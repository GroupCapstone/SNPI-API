# Enforce Layer 1 Dependency Supply Chain Defense (Ken Muse & Josh Johanning)
# Disables automatic execution of package lifecycle scripts (preinstall, install, postinstall)
# Blocks self-replicating worms (e.g. Shai-Hulud) and credential harvesters
ignore-scripts=true

# Ensures exact version pinning without loose semver ranges (^, ~) for deterministic builds
save-exact=true
