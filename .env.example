# Example values only. Replace every replace-with value before starting the backend.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/snp_sms?replicaSet=rs0&directConnection=true
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10

# Use distinct random values for authentication secrets.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-different-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=replace-with-at-least-32-random-cookie-secret-characters
SUPER_ADMIN_USERNAME=replace-with-the-initial-admin-username
SUPER_ADMIN_EMAIL=replace-with-admin@example.invalid
SUPER_ADMIN_PASSWORD=replace-with-a-strong-administrator-password
DEV_SEED_PASSWORD=replace-with-a-private-16-character-development-password

# Zero-Trust Machine-to-Machine (M2M) trusted client verification
CLIENT_API_KEY=replace-with-at-least-16-character-client-api-key
ENFORCE_CLIENT_AUTH=false

# Optional external notification providers. Missing credentials fail dispatch.
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
