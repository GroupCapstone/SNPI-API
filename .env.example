# ==============================================================================
# SNP-SMS Root Monorepo Environment Configuration Template
# For workspace-specific variables, refer to apps/backend/.env.example and apps/frontend/.env.example
# ==============================================================================

# Node Environment
NODE_ENV=development

# Backend Modular Monolith API
BACKEND_PORT=4000
BACKEND_INTERNAL_URL=http://127.0.0.1:4000

# Frontend Next.js Web App
FRONTEND_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Replica Set (rs0)
MONGODB_URI=mongodb://127.0.0.1:27017/snp_sms?replicaSet=rs0

# JWT Authentication Secrets
JWT_SECRET=snp_sms_local_dev_secret_key_minimum_32_chars_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=snp_sms_local_dev_refresh_secret_key_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Telegram Status & Security Watcher
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN_SAMPLE>
TELEGRAM_CHAT_ID=<TELEGRAM_CHAT_ID_SAMPLE>
