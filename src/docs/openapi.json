{
  "openapi": "3.1.0",
  "info": {
    "title": "SNP-SMS Enterprise Modular Monolith REST API",
    "version": "0.2.7",
    "description": "Enterprise School Management Platform RESTful API with versioned endpoints, granular RBAC, cryptographic ledger proofs, RFC 7807 problem details, and idempotency write guards.",
    "contact": {
      "name": "SNP-SMS Engineering Team",
      "url": "https://api.snpis.kesararamwithdigital.tech"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Production Modular Monolith API v1 Base"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access JWT token providing user roles and branch permissions."
      },
      "InternalServiceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-service-token",
        "description": "Pre-shared secret granting Fabric operator and internal microservice privileges."
      },
      "IdempotencyKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Idempotency-Key",
        "description": "UUIDv4 unique transaction key to prevent duplicate writes on payment and enrollment operations."
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 7807 / RFC 9457 Problem Details specification for API errors.",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "example": "https://api.snpis.kesararamwithdigital.tech/errors/validation_error"
          },
          "title": {
            "type": "string",
            "example": "Unprocessable Entity"
          },
          "status": {
            "type": "integer",
            "example": 422
          },
          "detail": {
            "type": "string",
            "example": "Validation failed on supplied payload."
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/students"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "success": {
            "type": "boolean",
            "example": false
          },
          "invalidParams": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        },
        "required": ["type", "title", "status", "detail", "code", "success"]
      },
      "ApiResponseEnvelope": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "type": "object" },
          "meta": { "type": "object" }
        },
        "required": ["success", "data"]
      },
      "CertificateVerification": {
        "type": "object",
        "properties": {
          "valid": { "type": "boolean", "example": true },
          "documentNumber": { "type": "string", "example": "CRT-2026-0042" },
          "contentHash": { "type": "string", "example": "8f4e2c1b9a7d3e5f..." },
          "ledger": {
            "type": "object",
            "properties": {
              "blockNumber": { "type": "integer", "example": 1420 },
              "transactionId": { "type": "string", "example": "tx-8f4e2c1b..." },
              "channel": { "type": "string", "example": "snpsmschannel" },
              "status": { "type": "string", "enum": ["COMMITTED_TAMPER_PROOF", "TAMPER_DETECTED"] },
              "merkleRoot": { "type": "string" }
            }
          },
          "fabricCredentials": {
            "type": "object",
            "description": "Fabric operator credentials returned strictly to authenticated internal backend services."
          }
        },
        "required": ["valid", "documentNumber", "contentHash", "ledger"]
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "System Health & Database Status",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Health status response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "UP" },
                    "database": { "type": "string", "example": "CONNECTED" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reports/certificates/verify/{code}": {
      "get": {
        "summary": "Cryptographic Certificate Ledger Verification",
        "description": "Public verification endpoint to verify certificate hashes against trusted ledger records. Fabric transaction credentials are strictly redacted unless authorized via x-service-token.",
        "tags": ["Certificates & Ledger"],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The certificate document number (e.g. CRT-12345678)"
          },
          {
            "name": "pretty",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "Whether to return pretty-printed JSON response (GitHub-style 2-space indentation)"
          }
        ],
        "responses": {
          "200": {
            "description": "Cryptographic certificate verification envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateVerification"
                }
              }
            }
          },
          "404": {
            "description": "Certificate not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (60 requests per 15 minutes)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Staff & Student Authentication",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["username", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authentication successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    }
  }
}
