{
  "name": "snp-sms-monorepo",
  "version": "0.2.15",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build:shared || true",
    "build:shared": "npm run build --workspace=@snp/shared",
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:proxy": "tsx scripts/local-proxy.ts",
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "lint": "npm run build:shared && npm run lint --workspaces --if-present",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "smoke": "tsx scripts/monorepo-smoke.ts",
    "seed:complete": "npm run seed:complete --workspace=apps/backend",
    "seed:protect": "npm run seed:protect --workspace=apps/backend",
    "test:api": "tsx scripts/test-all-apis.ts",
    "deploy:verify": "tsx scripts/verify-deploy-gate.ts",
    "changelog:sync": "tsx scripts/sync-changelog.ts",
    "watch:telegram": "tsx scripts/telegram-repo-watcher.ts --watch",
    "alert:telegram": "tsx scripts/telegram-repo-watcher.ts --once",
    "test:telegram": "tsx scripts/telegram-repo-watcher.ts --test",
    "turbo": "turbo",
    "build:turbo": "turbo run build",
    "test:turbo": "turbo run test",
    "typecheck:turbo": "turbo run typecheck",
    "lint:turbo": "turbo run lint"
  },
  "dependencies": {
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.19.3",
    "turbo": "^2.11.10",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": "^20.18.0 || ^22.13.0"
  },
  "packageManager": "npm@10.8.2"
}
