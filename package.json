{
  "name": "snp-sms-monorepo",
  "version": "0.2.17",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build:shared || true",
    "build:shared": "npm run build --workspace=@snp/shared",
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:proxy": "tsx scripts/local-proxy.ts",
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "lint": "npm run build:shared && npm run lint --workspaces --if-present",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "smoke": "tsx scripts/monorepo-smoke.ts",
    "seed:complete": "npm run seed:complete --workspace=apps/backend",
    "seed:protect": "npm run seed:protect --workspace=apps/backend",
    "test:api": "tsx scripts/test-all-apis.ts",
    "test:compression": "tsx scripts/test-git-compression.ts",
    "lfs:verify": "tsx scripts/verify-lfs-policy.ts",
    "verify:arc": "tsx scripts/verify-arc-config.ts apps/backend/infrastructure/k8s/arc/arc-runner-scaleset-standard.yaml",
    "verify:mirror": "tsx scripts/verify-mirror-freshness.ts infrastructure/resilience/mirror-config.yaml",
    "verify:private-network": "tsx scripts/verify-private-network-config.ts infrastructure/networking/actions-private-network/network-config.yaml",
    "verify:threat-model": "tsx scripts/verify-repository-threat-model.ts infrastructure/security/threat-model/repository-threat-model.yaml",
    "verify:supply-chain": "tsx scripts/verify-supply-chain-defense.ts",
    "audit:supply-chain": "tsx scripts/verify-supply-chain-defense.ts",
    "verify:workflows": "tsx scripts/verify-workflow-security.ts",
    "verify:ghas": "tsx scripts/verify-ghas-enforcement.ts",
    "verify:repo-strategy": "tsx scripts/verify-repo-architecture.ts",
    "verify:large-repo": "tsx scripts/verify-large-repo-management.ts",
    "verify:all-standards": "npm run verify:arc && npm run verify:mirror && npm run verify:private-network && npm run verify:threat-model && npm run verify:supply-chain && npm run verify:workflows && npm run verify:ghas && npm run verify:repo-strategy && npm run verify:large-repo && npm run audit:appsec",
    "audit:architecture": "tsx scripts/audit-architecture.ts",
    "audit:appsec": "tsx scripts/verify-appsec-checklist.ts",
    "appsec:verify": "tsx scripts/verify-appsec-checklist.ts",
    "deploy:verify": "tsx scripts/verify-deploy-gate.ts",
    "git:sync": "tsx scripts/dual-dev-git-sync.ts",
    "changelog:sync": "tsx scripts/sync-changelog.ts",
    "push:checkpoint": "tsx scripts/automated-push-checkpoint.ts",
    "push:verify": "tsx scripts/verify-ci-status.ts",
    "watch:telegram": "tsx scripts/telegram-repo-watcher.ts --watch",
    "alert:telegram": "tsx scripts/telegram-repo-watcher.ts --once",
    "test:telegram": "tsx scripts/telegram-repo-watcher.ts --test",
    "turbo": "turbo",
    "build:turbo": "turbo run build",
    "test:turbo": "turbo run test",
    "typecheck:turbo": "turbo run typecheck",
    "lint:turbo": "turbo run lint"
  },
  "dependencies": {
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.19.3",
    "turbo": "^2.11.10",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": "^20.18.0 || ^22.13.0"
  },
  "packageManager": "npm@10.8.2"
}
