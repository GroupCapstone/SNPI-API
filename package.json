{
  "name": "snpi-api",
  "version": "1.0.0",
  "private": true,
  "description": "SNPI School Management System - Dedicated Headless REST API (Express 5, MongoDB)",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist/docs', {recursive:true}); fs.copyFileSync('src/docs/openapi.json', 'dist/docs/openapi.json'); fs.copyFileSync('src/docs/explorer.html', 'dist/docs/explorer.html');\"",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:api": "tsx scripts/test-all-apis.ts",
    "test:api:all": "tsx scripts/test-comprehensive-api-suite.ts",
    "test:api:prod": "API_BASE_URL=https://api.kesararamwithdigital.tech tsx scripts/test-all-apis.ts",
    "smoke": "tsx scripts/monorepo-smoke.ts",
    "audit:appsec": "tsx scripts/verify-appsec-checklist.ts",
    "verify:api-stylebook": "tsx scripts/verify-api-stylebook-global-design.ts",
    "audit:architecture": "tsx scripts/audit-architecture.ts",
    "lfs:verify": "tsx scripts/verify-lfs-policy.ts",
    "deploy:verify": "tsx scripts/verify-deploy-gate.ts",
    "deploy:vercel": "npx vercel --prod",
    "deploy:prod": "npx vercel --prod",
    "deploy:preview": "npx vercel",
    "team:push": "npm run git:sync && git push origin main",
    "push:github": "npm run git:sync && git push origin main",
    "push:capstone": "git push groupcapstone main",
    "release:all": "tsx scripts/release-pipeline.ts",
    "git:sync": "tsx scripts/dual-dev-git-sync.ts",
    "changelog:sync": "tsx scripts/sync-changelog.ts",
    "push:checkpoint": "tsx scripts/automated-push-checkpoint.ts",
    "push:green": "tsx scripts/check-deploy-push-green.ts",
    "check:deploy:push": "tsx scripts/check-deploy-push-green.ts",
    "push:verify": "tsx scripts/verify-ci-status.ts",
    "verify:private-network": "tsx scripts/verify-private-network-config.ts infrastructure/networking/actions-private-network/network-config.yaml",
    "verify:threat-model": "tsx scripts/verify-repository-threat-model.ts infrastructure/security/threat-model/repository-threat-model.yaml",
    "verify:workflows": "tsx scripts/verify-workflow-security.ts",
    "verify:ghas": "tsx scripts/verify-ghas-enforcement.ts",
    "verify:supply-chain": "tsx scripts/verify-supply-chain-defense.ts",
    "verify:repo-strategy": "tsx scripts/verify-repo-architecture.ts",
    "verify:large-repo": "tsx scripts/verify-large-repo-management.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:complete": "tsx src/scripts/seed-complete-test-data.ts",
    "seed:clean": "tsx src/scripts/seed-clean.ts",
    "db:clear": "tsx src/scripts/clear-db.ts",
    "db:reset": "tsx src/scripts/clear-db.ts && tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
