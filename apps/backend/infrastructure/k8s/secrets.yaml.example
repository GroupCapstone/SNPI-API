apiVersion: v1
kind: Secret
metadata:
  name: snp-sms-secrets
  namespace: snp-sms
type: Opaque
# Template only. Inject real values through the cluster secret manager before deployment.
stringData:
  MONGODB_URI: replace-with-a-TLS-enabled-mongodb-uri
  JWT_ACCESS_SECRET: replace-with-a-private-random-access-secret
  JWT_REFRESH_SECRET: replace-with-a-different-private-random-refresh-secret
  COOKIE_SECRET: replace-with-a-third-private-random-cookie-secret
  SUPER_ADMIN_USERNAME: replace-with-the-initial-admin-username
  SUPER_ADMIN_EMAIL: replace-with-admin@example.invalid
  SUPER_ADMIN_PASSWORD: replace-with-a-private-admin-password
  TELEGRAM_BOT_TOKEN: ''
  TWILIO_ACCOUNT_SID: ''
  TWILIO_AUTH_TOKEN: ''
  TWILIO_FROM_NUMBER: ''
