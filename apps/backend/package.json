{
  "name": "snp-sms-backend",
  "version": "0.2.11",
  "private": true,
  "main": "src/server.ts",
  "scripts": {
    "build:shared": "npm run build --workspace=@snp/shared --prefix=../..",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "seed:complete": "tsx src/scripts/seed-complete-test-data.ts",
    "seed:protect": "rm -f src/scripts/seed-complete-test-data.ts && echo '[PROTECT] Temporary seeder script safely deleted.'",
    "seed:clean": "tsx src/scripts/seed-clean.ts",
    "db:clear": "tsx src/scripts/clear-db.ts",
    "db:reset": "tsx src/scripts/clear-db.ts && tsx src/scripts/seed.ts",
    "migrate:historical:check": "tsx src/scripts/historical-data-migration.ts",
    "migrate:historical:apply": "tsx src/scripts/historical-data-migration.ts --apply",
    "migrate:tenant:check": "tsx src/scripts/tenant-scope-migration.ts",
    "migrate:tenant:apply": "tsx src/scripts/tenant-scope-migration.ts --apply",
    "credentials:check": "tsx src/scripts/cleanup-credentials.ts",
    "credentials:clean": "tsx src/scripts/cleanup-credentials.ts --apply",
    "smoke:workflows": "tsx scripts/rebuild-smoke.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@snp/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@snp/eslint-config": "*",
    "@snp/tsconfig": "*",
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^20.18.0 || ^22.13.0"
  }
}
